{
  "name": "modusaas",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "pnpm db:generate && next build && node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env scripts/start-production.mjs",
    "setup": "node --import tsx scripts/setup.ts",
    "db:generate": "node --import tsx scripts/generate-client.ts",
    "db:migrate": "node --import tsx scripts/prisma-wasm.ts deploy",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm db:generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "create-saas": "tsx tooling/create-saas/index.ts",
    "benchmark": "tsx tooling/benchmark.ts",
    "test:generator": "node --import tsx scripts/test-generator.ts",
    "test:email": "node --import tsx scripts/test-email.ts",
    "size": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.88",
    "@ai-sdk/google": "4.0.105",
    "@ai-sdk/openai": "4.0.102",
    "@aws-sdk/client-s3": "3.1156.0",
    "@hookform/resolvers": "6.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/client-runtime-utils": "7.10.1",
    "@react-email/render": "2.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-table": "8.21.3",
    "ai": "7.0.153",
    "better-auth": "1.7.13",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.9",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "stripe": "23.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@prisma/client-generator-js": "7.10.1",
    "@prisma/internals": "7.10.1",
    "@types/node": "24.10.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "vitest": "5.0.5",
    "@next/eslint-plugin-next": "16.4.3",
    "typescript-eslint": "8.72.1",
    "eslint-plugin-react-hooks": "7.1.1"
  }
}
